# Production build defaults for user-app-client. Vite loads this on
# `vite build` (mode=production). Real env vars set in the deploy platform
# (Netlify) take precedence over this file, so this is a safe in-repo default.

# support-bridge base URL. After the one-box Chatwoot migration (support D-033)
# the bridge is path-routed under /bridge on support.p2p.me.
#
# This has to be set for "Talk to a human" to exist at all: support-chat.ts
# only hands {signer, bridgeUrl} to the widget when both are present, and
# otherwise hides the action by design — silently, with nothing logged. With
# the value only in .env.example (blank) and nowhere else, a Netlify build
# missing the variable ships a build where the feature simply is not there.
# Local dev: http://localhost:3002
VITE_SUPPORT_BRIDGE_URL=https://support.p2p.me/bridge
